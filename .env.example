NODE_ENV=development
APP_NAME=MoiDate
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:3000
# Shown in /api/v1/help and the in-app help page
SUPPORT_EMAIL=support@example.com
# Admin console (/admin/login): migration seeds admin@moidate.com (see prisma/migrations/*seed_admin*).
# Deploy migrations then sign in; rotate password in production.
# Custom server (npm run dev:full): Socket.io CORS origins, comma-separated, or omit for reflect request origin
SOCKET_CORS_ORIGIN=http://localhost:3000

JWT_SECRET=replace_me_with_strong_secret
JWT_REFRESH_SECRET=replace_me_with_strong_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_DAYS=30
BCRYPT_ROUNDS=12
OTP_PEPPER=

# Neon Postgres — replace with a REAL URL or migrations will fail (P1001).
# 1) https://console.neon.tech → your project → Dashboard → "Connection details"
# 2) Copy the URI (use the "psql" or pooled connection string). It looks like:
#    postgresql://USER:SECRET@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# 3) Put it in .env.local (preferred) so it is not committed. Remove YOUR-NEON-HOST placeholders.
# 4) Then: npm run prisma:migrate:neon
DATABASE_URL=postgresql://neondb_owner:npg_CgTvI2MOiZ6d@ep-sparkling-wind-aqs30yky.c-8.us-east-1.aws.neon.tech/neondb?sslmode=require
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# API requests / minute per IP (middleware). Uses Upstash when URL+token set; else in-memory.
API_RATE_LIMIT_PER_MIN=120

RESEND_API_KEY=
RESEND_FROM=MoiDate <onboarding@resend.dev>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

OPENAI_API_KEY=
# Optional overrides (defaults: gpt-4o-mini, text-embedding-3-small)
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=
PINECONE_API_KEY=
PINECONE_INDEX=moi-date-matching
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=

# Matching
SUPERLIKES_PER_DAY=5
SWIPE_UNDO_WINDOW_MS=86400000

# Verification vendor (optional)
KYC_VENDOR_WEBHOOK_URL=
